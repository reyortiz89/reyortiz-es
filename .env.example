# Public URL of the site (canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://reyortiz.es

# Booking link for "Book a call" buttons (Cal.com / Calendly). Buttons are hidden when empty.
NEXT_PUBLIC_BOOKING_URL=

# NIF shown on the legal pages (aviso legal / privacidad).
NEXT_PUBLIC_LEGAL_NIF=

# --- Email: SMTP of the Closeby account (rey@closeby.com) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=rey@closeby.com
SMTP_PASS=
SMTP_FROM=rey@closeby.com
SMTP_FROM_NAME=Rey Ortiz
# Where new-lead notifications go (defaults to SMTP_FROM).
LEADS_NOTIFY_TO=

# --- Closeby: every lead is POSTed here as JSON ---
CLOSEBY_WEBHOOK_URL=
CLOSEBY_API_KEY=

# --- Cloudflare Turnstile antispam (optional, recommended in production) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
