# Copy these into Vercel → Project → Settings → Environment Variables.
# Variables starting with NEXT_PUBLIC_ are baked in at build time: redeploy after changing them.

# Public URL of the site (canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://reyortiz.es

# Booking page embedded on /contact and at the end of the home, also opened by every "Book a call" button.
# Defaults to the Closevibe agenda (https://closevibe.com/r/closevibe-agenda/demo) when empty.
NEXT_PUBLIC_CALENDLY_URL=

# --- Email: Namecheap Private Email (rey@closevibe.com) ---
# Host and user have these defaults in code; only SMTP_PASS is strictly required.
SMTP_HOST=mail.privateemail.com
# 465 = SSL (recommended). Use 587 for STARTTLS.
SMTP_PORT=465
SMTP_USER=rey@closevibe.com
SMTP_PASS=
SMTP_FROM=rey@closevibe.com
SMTP_FROM_NAME=Rey Ortiz
# Where new-lead notifications go (defaults to SMTP_FROM).
LEADS_NOTIFY_TO=rey@closevibe.com

# --- Optional: forward every lead as JSON to a CRM / automation webhook ---
# Leave empty while the CRM is managed by hand.
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_TOKEN=

# --- Optional: Cloudflare Turnstile antispam ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Videos (/videos) ---
# Where each video is hosted, as JSON: {"slug": "link"} or {"slug": {"url": "link", "duration": "12 min"}}.
# Slugs are in content/videos.ts. A video without an entry shows as "coming soon" with a waitlist.
# Vimeo (private, embeds limited to reyortiz.es) is recommended; YouTube unlisted, Loom or a direct .mp4 also work.
# Read at build time for the library and at request time for playback: redeploy after changing it.
VIDEO_SOURCES=
